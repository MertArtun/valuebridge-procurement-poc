MOCKDESK_URL=http://127.0.0.1:8001
VALUEBRIDGE_DB_PATH=runtime/valuebridge.db
MOCKDESK_DB_PATH=runtime/mockdesk.db
# Optional: enables the LLM narrator and intake assistant; unset keeps them off.
VALUEBRIDGE_LLM_API_KEY=
# Provider model id, defaults to anthropic/claude-sonnet-5.
VALUEBRIDGE_LLM_MODEL=anthropic/claude-sonnet-5
# OpenAI-compatible chat completions base URL.
VALUEBRIDGE_LLM_BASE_URL=https://openrouter.ai/api/v1
# Embedding model for the optional hybrid policy retrieval layer;
# without data/policy_embeddings.json retrieval stays lexical.
VALUEBRIDGE_EMBEDDINGS_MODEL=openai/text-embedding-3-small
