[Unit]
Description=ValueBridge public demo stack (docker compose)

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/valuebridge/app
ExecStart=/usr/bin/docker compose -p valuebridge -f docker-compose.yml -f docker-compose.demo.yml up -d
ExecStop=/usr/bin/docker compose -p valuebridge -f docker-compose.yml -f docker-compose.demo.yml down
TimeoutStartSec=0

[Install]
WantedBy=default.target
